#!/bin/bash
# 文件落盘后：确保依赖并安装接管服务。
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; . "${SELF_DIR}/_common"
# 第二道保险：未同意免责声明则不完成安装（正常已在 install_init 被拦截）
case "${wizard_agree_terms:-}" in
  *agree*|*true*|1|yes|on) ;;
  *) fnmedia_fail "未同意《免责声明》，已取消安装。本插件仅供学习交流，本身不内置任何影视资源。" ;;
esac
[ -n "${FNMEDIA_REPO_DIR}" ] || fnmedia_fail "应用文件缺失（deploy/install.sh 不存在）"
cd "${FNMEDIA_REPO_DIR}" || fnmedia_fail "无法进入应用目录"
if [ ! -x ".venv/bin/python" ]; then
  python3 -m venv .venv >> "${FNMEDIA_LOG}" 2>&1 || fnmedia_fail "创建 venv 失败"
  .venv/bin/pip install -q --upgrade pip >> "${FNMEDIA_LOG}" 2>&1 || true
  if ! .venv/bin/pip install -q fastapi "uvicorn" httpx >> "${FNMEDIA_LOG}" 2>&1; then
    # 国内直连 PyPI 常出现两个问题：files.pythonhosted.org 速度极低，以及下载内容
    # 被中间设备截断/改写导致 pip 报 "THESE PACKAGES DO NOT MATCH THE HASHES"。
    # 这类失败重试官方源没有意义，回退国内镜像再试一次；仍失败才报错。
    # 可用 FNMEDIA_PIP_INDEX / FNMEDIA_PIP_HOST 覆盖镜像。
    _IDX="${FNMEDIA_PIP_INDEX:-https://mirrors.aliyun.com/pypi/simple/}"
    _HOST="${FNMEDIA_PIP_HOST:-mirrors.aliyun.com}"
    echo "[fnmedia-ext] 官方源安装失败，回退镜像 ${_IDX}" >> "${FNMEDIA_LOG}" 2>&1
    .venv/bin/pip install -q -i "${_IDX}" --trusted-host "${_HOST}" \
      fastapi "uvicorn" httpx >> "${FNMEDIA_LOG}" 2>&1 \
      || fnmedia_fail "Python 依赖安装失败（官方源与镜像均失败，详见 ${FNMEDIA_LOG}）"
  fi
fi
bash deploy/install.sh >> "${FNMEDIA_LOG}" 2>&1 || { tail -n 8 "${FNMEDIA_LOG}" >&2 || true; fnmedia_fail "接管服务启动失败，详见 ${FNMEDIA_LOG}"; }
exit 0

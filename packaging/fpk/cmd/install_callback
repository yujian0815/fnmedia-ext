#!/bin/bash
# 文件落盘后：确保依赖并安装接管服务。
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; . "${SELF_DIR}/_common"
# 第二道保险：未同意免责声明则不完成安装（正常已在 install_init 被拦截）
case "${wizard_agree_terms:-}" in
  *agree*|*true*|1|yes|on) ;;
  *) fnmedia_fail "未同意《免责声明》，已取消安装。本插件仅供学习交流，本身不内置任何影视资源。" ;;
esac
[ -n "${FNMEDIA_REPO_DIR}" ] || fnmedia_fail "应用文件缺失（deploy/install.sh 不存在）"
cd "${FNMEDIA_REPO_DIR}" || fnmedia_fail "无法进入应用目录"
# 依赖：venv 缺失或核心包 import 失败时统一引导（离线 wheelhouse 优先、国内镜像兜底）。
need_deps=1
if [ -x ".venv/bin/python" ] && .venv/bin/python -c 'import fastapi,uvicorn,httpx' >/dev/null 2>&1; then
  need_deps=0
fi
if [ "$need_deps" = "1" ]; then
  bash deploy/bootstrap_deps.sh || {
    tail -n 14 "${FNMEDIA_LOG}" >&2 2>/dev/null || true
    fnmedia_fail "Python 运行环境准备失败（已尝试内置离线包与多个国内镜像），详见 ${FNMEDIA_LOG}"
  }
fi
bash deploy/install.sh >> "${FNMEDIA_LOG}" 2>&1 || { tail -n 8 "${FNMEDIA_LOG}" >&2 || true; fnmedia_fail "接管服务启动失败，详见 ${FNMEDIA_LOG}"; }
exit 0
